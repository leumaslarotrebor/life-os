# LIFE OS — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase or local instance)
DATABASE_URL=postgresql://user:password@host:5432/lifeos

# ─── AWS / Bedrock ───────────────────────────────────────────────────────────
# AWS region where your Bedrock model is available
AWS_REGION=us-east-1

# Bedrock model ID (confirm availability in your region before setting)
# Example values: anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# AWS credentials — prefer IAM role / aws sso login over hardcoded keys.
# Leave blank if using a named profile or instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ─── MCP Server ──────────────────────────────────────────────────────────────
# Port the MCP server listens on
MCP_SERVER_PORT=8001

# Base URL the backend uses to reach the MCP server
MCP_SERVER_URL=http://localhost:8001

# ─── Backend ─────────────────────────────────────────────────────────────────
# Port the FastAPI backend listens on
BACKEND_PORT=8000

# Secret key for signing sessions / tokens
SECRET_KEY=change-me-before-running

# ─── Frontend ────────────────────────────────────────────────────────────────
# Backend API URL the frontend connects to
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Development ─────────────────────────────────────────────────────────────
# Set to "development" or "production"
ENVIRONMENT=development

# Enable debug logging (true/false)
DEBUG=true
